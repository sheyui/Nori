<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Nori.ViewModels"
             xmlns:models="clr-namespace:Nori.Models"
             x:Class="Nori.Views.TasksPage"
             x:Name="ThisPage"
             Title="Мои задачи">



    <Grid RowDefinitions="Auto, *, Auto" Padding="15" RowSpacing="15">

        <!-- Поле ввода + кнопка -->
        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">

            <Button Grid.Column="1"
                Text="Добавить"
                Clicked="OnAddTaskClicked"
                WidthRequest="110" />
        </Grid>

        <!-- Список задач -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Tasks}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TaskItem">
                    <Border Stroke="#E0E0E0"
                StrokeThickness="1"
                Padding="14"
                Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTaskTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto, *, Auto" 
                  ColumnSpacing="12"
                  VerticalOptions="Center">

                            <!-- Галочка выполнения -->
                            <CheckBox IsChecked="{Binding IsCompleted}"
                          Color="#4A90E2"
                          VerticalOptions="Center"
                          CheckedChanged="OnTaskCheckedChanged" />

                            <!-- Название + информация -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">

                                <Label Text="{Binding Title}"
                           FontSize="16"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           MaxLines="2">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                         Binding="{Binding IsCompleted}"
                                         Value="True">
                                            <Setter Property="TextColor" Value="Gray" />
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label FontSize="13" TextColor="#757575">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0}  •  до {1:dd.MM.yyyy}">
                                            <Binding Path="Priority" />
                                            <Binding Path="DueDate" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                            </VerticalStackLayout>

                            <!-- Кнопка удаления -->
                            <Button Grid.Column="2"
                        Text="✕"
                        BackgroundColor="Transparent"
                        TextColor="#E53935"
                        FontSize="18"
                        WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Center"
                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RemoveTaskCommand}"
                        CommandParameter="{Binding .}" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!-- Кнопка перехода -->
        <Button Grid.Row="2"
        Text="О приложении"
        Clicked="OnAboutClicked"
        Margin="0,15,0,0"
        HorizontalOptions="Center"
        WidthRequest="180" />
    </Grid>
</ContentPage>